# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Tavily (web search + source validation) ────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Polymarket (crypto prediction market) ─────────────────────────────────────
# Get from: https://polymarket.com  (Polygon wallet private key)
POLYMARKET_PRIVATE_KEY=your_polygon_private_key_here

# ── Kalshi (US regulated prediction market) ────────────────────────────────────
# Get from: https://kalshi.com/settings/api-keys
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_EMAIL=your_kalshi_email_here
KALSHI_PASSWORD=your_kalshi_password_here

# ── Manifold Markets (play-money prediction market) ───────────────────────────
# Get from: https://manifold.markets/profile → Settings → API key
MANIFOLD_API_KEY=your_manifold_api_key_here

# ── Budget ─────────────────────────────────────────────────────────────────────
# The bot has $50 TOTAL — this covers API costs (Tavily + Claude) AND real bets.
# budget.json tracks spending between runs.
TOTAL_BUDGET_USD=50

# ── Bot settings ───────────────────────────────────────────────────────────────
DRY_RUN=true              # Set to false to place real bets
MAX_BET_USD=5             # Max dollars per real-money bet (conservative)
MAX_BET_MANA=100          # Max mana per Manifold bet (play-money, doesn't cost $)
KELLY_FRACTION=0.25       # Fractional Kelly (0.25 = quarter Kelly, conservative)
MIN_EDGE=0.05             # Minimum edge required to place a bet (5%)
