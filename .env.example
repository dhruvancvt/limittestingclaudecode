# ============================================================
# Claude Code Remote – Environment Variables
# Copy to .env and fill in values before starting
# ============================================================

# ---- REQUIRED -----------------------------------------------
# Shared secret used to obtain JWT tokens from the /auth/token endpoint.
# Pick a long random string: openssl rand -hex 32
AUTH_SECRET=change-me-now

# ---- Optional – override defaults ---------------------------

# Secret used to sign JWTs (auto-generated if blank, but set one for
# persistence across restarts)
JWT_SECRET=

# Token lifetime in hours (default: 72)
JWT_EXPIRE_HOURS=72

# Bind address (default 0.0.0.0 – listens on all interfaces including Tailscale)
HOST=0.0.0.0
PORT=8000

# Path to the claude binary (default: claude, assumed on PATH)
CLAUDE_BINARY=claude

# Default working directory for new sessions
DEFAULT_WORKING_DIR=/home/user

# Maximum number of concurrent sessions
MAX_SESSIONS=10

# Maximum session idle time in seconds before cleanup (default 2 hours)
SESSION_TIMEOUT_SECONDS=7200

# Comma-separated list of allowed CORS origins, or * for all (default: *)
# For production set this to your Tailscale frontend origin, e.g.:
#   CORS_ORIGINS=http://100.x.x.x:5173,https://myhost.tail12345.ts.net
CORS_ORIGINS=*
